  "cards": [
    {
      "dot": "cyan",
      "title": "Clients: offline first",
      "items": [
        "Decks cached in SQLite (SQLDelight / GRDB) so study works with no network",
        "Sync sends only deltas: card edits, review state, new decks",
        "Generation requests return a job id; cards appear when the job finishes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Service: reuse the gem",
      "items": [
        "Sync API is a thin Ruby service over the existing AnkiGenerator::* objects",
        "Solid Queue + one worker process run AI generation out of request path",
        "Web client is today's serve UI with auth and the API as backend"
      ]
    },
    {
      "dot": "rose",
      "title": "Cost: hobbyist scale",
      "items": [
        "One small VPS or free-tier container runs API + worker + queue",
        "PostgreSQL: managed free tier or the same VPS",
        "LLM cost stays pay-per-use via OpenRouter, or $0 with a local Ollama sidecar"
      ]
    }
  ]
